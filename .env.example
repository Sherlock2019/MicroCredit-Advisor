# Copy to .env for local Docker Compose. Every value here is a LOCAL DEVELOPMENT placeholder.
# Never put real credentials in this file or commit .env (it is git-ignored).

# --- PostgreSQL (local container) ---------------------------------------------------------------
POSTGRES_OWNER_PASSWORD=change-me-local-owner
SVC_GATEWAY_DB_PASSWORD=change-me-local-gateway
SVC_FINANCE_DB_PASSWORD=change-me-local-finance
SVC_PROJECTS_DB_PASSWORD=change-me-local-projects
POSTGRES_HOST_PORT=55433

# --- identity -----------------------------------------------------------------------------------
# Dev tokens let the portal switch between demo accounts. Local only; refused when DEPLOYMENT_TARGET=azure-aks.
AUTH_DEV_MODE=true
AUTH_DEV_JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
AGENT_TOKEN_SECRET=replace-with-another-32-plus-character-random-value

# Entra ID (Azure). Leave empty locally.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=api://ifad-rural-ai-platform
OIDC_TENANT_CLAIM=tenant_id

# --- model gateway ------------------------------------------------------------------------------
# mock = deterministic and offline (default). ollama = local models on the host.
MODEL_PROVIDER=mock
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=all-minilm

# --- ports --------------------------------------------------------------------------------------
GATEWAY_PORT=8400
PORTAL_PORT=8480
