# Optional. Copy to .env only if you want to change a default. No passwords are needed.

# mock = deterministic and offline (default). ollama = local models on the host.
MODEL_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Ports
PORTAL_PORT=8480
GATEWAY_PORT=8400
POSTGRES_HOST_PORT=55433
